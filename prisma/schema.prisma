// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  // "client" mode generates a pure JS client with no native query-engine binary at all — required
  // for the Pi Zero W (32-bit ARM/"linux-arm"), an architecture Prisma doesn't publish an engine
  // binary for (confirmed via a 404 on prisma generate). Queries run entirely through the
  // @prisma/adapter-better-sqlite3 driver adapter already used at runtime (see prisma.server.ts).
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./picobrew.db"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  salt      String
  role      String    @default("Regular") // Regular | ReadOnly
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
}

model Config {
  key   String @id
  value String // json
}

model Device {
  id                   Int       @id @default(autoincrement())
  name                 String
  uid                  String    @unique
  deviceType           String //enum
  state                Int       @default(0) // enum
  ipAddress            String?
  firmwareVersion      String?
  sessionCount         Int       @default(0)
  lastDeepCleanSession Int?
  color                String? // For Tilt hydrometers: Red, Green, Black, Purple, Orange, Blue, Yellow, Pink
  metadata             String? // JSON for additional device-specific data
  // Bumped on every inbound check-in from the device itself (register, poll, log, ...) — these
  // devices only ever call out to us, so this is the "we definitely heard from it recently" signal.
  lastSeenAt           DateTime?
  // Resolved via the LAN's ARP/neighbor table (see device-network-monitor.server.ts) the first
  // time we see this device's IP, then used to re-find it there on later ticks — this survives a
  // DHCP lease renewal handing the device a new IP, which a stale ipAddress alone would not.
  macAddress           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  deletedAt            DateTime?

  sessions      Session[]
  logs          DeviceLog[]
  fermentBatches Batch[]
}

// A hardware uid the server has seen check in but that hasn't been claimed into a named Device
// yet — mirrors the reference server's "registered but unaliased" in-memory session, except we
// persist it so it survives a restart until someone pairs it from the Devices settings page.
model DiscoveredDevice {
  uid         String   @id
  deviceType  String? //enum — null when the wire protocol can't disambiguate the model (Pico S/C/Pro)
  metadata    String? // JSON — e.g. Tilt color, last-seen IP
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now()) @updatedAt
}

model Recipe {
  id          Int       @id @default(autoincrement())
  deviceType  String //enum
  packType    String    @default("zpack") // enum: picopack | zpack — see app/types.ts RecipePackType
  name        String
  abv         Float
  ibu         Float
  style       String? //https://www.bjcp.org/beer-styles/beer-style-guidelines/
  og          Float?
  fg          Float?
  colorSRM    Int? //https://www.twobeerdudes.com/index.php/beer/srm
  fermentDays Int? //days
  image       String
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  // Beer-science recipe editor fields (target ranges + brew-day parameters)
  photoUrl         String?
  ogMin            Float?
  ogMax            Float?
  fgMin            Float?
  fgMax            Float?
  ibuMin           Float?
  ibuMax           Float?
  srmMin           Float?
  srmMax           Float?
  abvMin           Float?
  abvMax           Float?
  batchSize        Float? // gallons
  mashType         Int? // enum: 0=Single Step, 1=High Efficiency Multi Step, 2=Custom, 3=Single Step With Mash Out
  boilTime         Int? // minutes
  boilTemp         Int? // °F
  firstWortHopping Boolean @default(false)
  fermentationType Int? // enum: 0=Ale, 1=Lager, 2=Advanced/Custom
  yeastName        String?
  yeastAttenuation Float?
  yeastRangeTemp   String?
  yeastPitchTemp   Int?

  steps       RecipeStep[]
  session     Session[]
  ingredients RecipeIngredient[]
  batches     Batch[]
}

// A Batch ties together one beer's whole lifecycle — the machine-driven Brewing
// leg, an optional Tilt-tracked Fermentation leg, and user-tracked Carbonation —
// so the Session Detail view can show them as one continuous phase stepper.
// Brewing/Fermentation Sessions point at a Batch via Session.batchId; Carbonation
// has no device driving it, so its state lives directly on the Batch.
model Batch {
  id          Int       @id @default(autoincrement())
  name        String
  recipeId    Int?
  phase       String    @default("Brewing") // Brewing | Cooling | Fermenting | Bottling | Carbonating | Completed | Canceled
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  completedAt DateTime?

  carbMethod        String? // Bottle | Keg | Forced (CO2)
  carbDuration      Float?
  carbUnit          String? // weeks | hours
  carbStartedAt     DateTime?
  carbStatus        String? // setup | counting | extend | finished
  carbExtendMinutes Int?

  // Tilt hydrometer picked (optionally) when the session was started, so the Fermentation
  // section can pre-fill "Start Tracking" once the batch actually reaches that phase.
  fermentDeviceId Int?

  recipe        Recipe?   @relation(fields: [recipeId], references: [id])
  fermentDevice Device?   @relation(fields: [fermentDeviceId], references: [id])
  sessions      Session[]
  aiAdvice      AiAdvice[]
}

model AiAdvice {
  id        Int      @id @default(autoincrement())
  batchId   Int
  batch     Batch    @relation(fields: [batchId], references: [id])
  phase     String // Brewing | Fermenting at time of generation
  step      String? // the brew step the batch was on when this was written (Brewing advice only)
  trigger   String // scheduled | manual | phase-change | step
  content   String
  model     String // e.g. gpt-4o-mini
  createdAt DateTime @default(now())
}

model RecipeIngredient {
  id        Int    @id @default(autoincrement())
  recipeId  Int
  section   String // enum: WATER, MASH_STEP, FERMENTABLE, BOIL_HOP, OTHER_BOIL, FERMENTATION_STEP, DRY_HOP
  sortOrder Int    @default(0)
  name      String
  amount    Float?
  unit      String?
  color     Float?
  aa        Float?
  time      Int?
  temp      Int?
  days      Int?
  hours     Int?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RecipeStep {
  id          Int    @id @default(autoincrement())
  recipeId    Int
  name        String
  drainTime   Int
  location    Int // enum
  stepTime    Int
  temperature Int

  recipe Recipe @relation(fields: [recipeId], references: [id])
}

model Session {
  id            Int      @id @default(autoincrement())
  uid           String   @unique
  type          Int //enum
  deviceId      Int
  recipeId      Int?
  batchId       Int?
  state         Int // enum
  statusText    String
  timeRemaining Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  device Device       @relation(fields: [deviceId], references: [id])
  logs   SessionLog[]
  recipe Recipe?      @relation(fields: [recipeId], references: [id])
  batch  Batch?       @relation(fields: [batchId], references: [id])
}

model SessionLog {
  id        Int      @id @default(autoincrement())
  sessionId Int
  session   Session  @relation(fields: [sessionId], references: [id])
  type      Int // 0 = Brew log, 1 = Ferment log
  time      DateTime @default(now())
  data      String // json
}

model DeviceLog {
  id       Int      @id @default(autoincrement())
  deviceId Int
  device   Device   @relation(fields: [deviceId], references: [id])
  time     DateTime @default(now())
  data     String // json
}

// One thread per scope: exactly one 'general' thread (scopeId null), one per recipe, one per
// batch/session — the AI Brewmaster's conversation history persists here instead of resetting
// whenever the sidekick panel closes or the user navigates away and back.
model AiChatThread {
  id        Int      @id @default(autoincrement())
  scope     String // general | recipe | session
  scopeId   Int? // Recipe.id or Batch.id; null for the single 'general' thread
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  messages AiChatMessage[]

  @@unique([scope, scopeId])
}

model AiChatMessage {
  id        Int      @id @default(autoincrement())
  threadId  Int
  thread    AiChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String // the display text (user's message, or the AI's explanation/reply)
  metadata  String? // JSON: e.g. { recipeSnapshot, action } — structured extras beyond the text
  createdAt DateTime @default(now())
}
