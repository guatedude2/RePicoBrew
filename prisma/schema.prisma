// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./picobrew.db"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  salt      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
}

model Config {
  key   String @id
  value String // json
}

model Device {
  id                   Int       @id @default(autoincrement())
  name                 String
  uid                  String    @unique
  deviceType           String //enum
  state                Int       @default(0) // enum
  ipAddress            String?
  firmwareVersion      String?
  sessionCount         Int       @default(0)
  lastDeepCleanSession Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  deletedAt            DateTime?

  sessions Session[]
  logs     DeviceLog[]
}

model Recipe {
  id          Int       @id @default(autoincrement())
  deviceType  String //enum
  name        String
  abv         Float
  ibu         Float
  style       String? //https://www.bjcp.org/beer-styles/beer-style-guidelines/
  og          Float?
  fg          Float?
  colorSRM    Int? //https://www.twobeerdudes.com/index.php/beer/srm
  fermentDays Int? //days
  image       String
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  steps       RecipeStep[]
  session     Session[]
  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id     Int    @id @default(autoincrement())
  name   String
  type   Int //enum (GRAIN,HOP,YEAST,FLAVORING)
  amount Float
  unit   String //enum

  recipes Recipe[]
}

model RecipeStep {
  id          Int    @id @default(autoincrement())
  recipeId    Int
  name        String
  drainTime   Int
  location    String // enum
  stepTime    Int
  temperature Int

  recipe Recipe @relation(fields: [recipeId], references: [id])
}

model Session {
  id            Int      @id @default(autoincrement())
  uid           String   @unique
  type          Int //enum
  deviceId      Int
  recipeId      Int?
  state         Int // enum
  statusText    String
  timeRemaining Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  device Device       @relation(fields: [deviceId], references: [id])
  logs   SessionLog[]
  recipe Recipe?      @relation(fields: [recipeId], references: [id])
}

model SessionLog {
  id        Int      @id @default(autoincrement())
  sessionId Int
  session   Session  @relation(fields: [sessionId], references: [id])
  type      Int // 0 = Brew log, 1 = Ferment log
  time      DateTime @default(now())
  data      String // json
}

model DeviceLog {
  id       Int      @id @default(autoincrement())
  deviceId Int
  device   Device   @relation(fields: [deviceId], references: [id])
  time     DateTime @default(now())
  data     String // json
}
