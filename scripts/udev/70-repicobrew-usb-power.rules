# Keeps USB devices awake. Linux suspends idle USB devices to save power, and some USB Wi-Fi adapters (notably the
# Realtek RTL8188CUS in the Edimax EW-7811Un) don't wake back up properly, dropping the internet uplink.
# Installed by scripts/deploy-to-pi.sh and pi-image/chroot-provision.sh.
ACTION=="add", SUBSYSTEM=="usb", DEVTYPE=="usb_device", TEST=="power/control", ATTR{power/control}="on"
