# Reference copy — scripts/deploy-to-pi.sh installs this unit with the deploy user and app directory filled in;
# the Raspberry Pi image build (pi-image/chroot-provision-nm.sh) installs it as-is.
[Unit]
Description=RePicoBrew Server
Documentation=https://github.com/guatedude2/RePicoBrew
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/RePicoBrew
Environment="NODE_ENV=production"
Environment="PORT=8080"
# Runs node directly (not `pnpm start`): one process instead of pnpm + sh + node, and no pnpm needed at runtime.
ExecStart=/usr/local/bin/node node_modules/@react-router/serve/bin.js build/server/index.js
Restart=on-failure
RestartSec=10
# The app holds open live-update (SSE) connections, so a polite SIGTERM stop can hang until systemd's
# 90s default kills it; don't make every restart wait that long.
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=repicobrew

# Security hardening. NOT NoNewPrivileges=true: it disables setuid escalation entirely, including `sudo`, and this
# app deliberately relies on a few narrowly-scoped passwordless sudo commands (see app/utils/system-control.server.ts,
# app/utils/network-control.server.ts, /etc/sudoers.d/repicobrew-control) to restart itself, reboot the Pi and apply
# network config. Also NOT PrivateTmp=true: `wpa_cli` (the Wi-Fi network scan) receives replies on a socket in /tmp.

[Install]
WantedBy=multi-user.target
